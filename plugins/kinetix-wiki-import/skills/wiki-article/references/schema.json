{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "kinetix-wiki-article-v1"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "articleDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "page": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "pmid",
              "doi",
              "url"
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "metadata": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "authors": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "journal": {
                "type": "string",
                "maxLength": 500
              },
              "year": {
                "type": "integer",
                "minimum": 1500,
                "maximum": 2200
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "type",
          "identifier"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sectionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "level": {
            "anyOf": [
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "facts": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sourceKeys": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "evidence": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "sourceKey",
                      "locator"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "key",
                "statement",
                "sourceKeys"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "heading",
          "level",
          "facts"
        ],
        "additionalProperties": false
      }
    },
    "blockedCandidates": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sectionKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "sectionKey",
          "statement",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "articleDigest",
    "createdAt",
    "page",
    "sources",
    "sections"
  ],
  "additionalProperties": false
}
