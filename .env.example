# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/kinetix?sslmode=require

# Secret for signing JWT tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-here

# Separate HMAC secret for OTP codes (generate with: openssl rand -base64 32).
# Using a distinct key means a JWT_SECRET compromise does not also expose the
# OTP auth path (and vice versa). Falls back to JWT_SECRET when not set, so
# existing deployments continue to work without a migration.
MAGIC_LINK_HMAC_SECRET=

# ─── Citation PDF storage (Vercel Blob) ─────────────────────────────────────
# Read/write token for the Vercel Blob store that holds full-text PDFs
# supplied for citations (see api/citation-pdf.ts, api/citation-pdf-upload.ts).
# Auto-injected by Vercel when a Blob store is connected to the project;
# set explicitly only for local development against a real store.
BLOB_READ_WRITE_TOKEN=

# ─── Drug-DB maintenance agent (see agents/drug-db-maintainer.md) ───
# Base URL of the deployed Kinetix API the agent will POST/PUT against.
KINETIX_BASE_URL=https://kinetix.app
# Revocable kxat_ token for the kinetix-agent row (printed by
# `AGENT_SLUG=kinetix-agent npm run seed:agent-token`).
KINETIX_TOKEN=
# users.id of the kinetix-agent row (printed by `npm run seed:agent-user`).
AGENT_USER_ID=

# ─── Agent event hooks (see agents/comment-and-fact-evaluator.md, #345) ─────
# Full Claude Code Routines "fire" URL for the comment / fact evaluator
# routine. Format: https://api.anthropic.com/v1/claude_code/routines/<id>/fire
# Leaving this empty disables the hook (the API no-ops on every event).
CLAUDE_CODE_AGENT_HOOK_URL=
# Bearer token authorized for the routine above.
CLAUDE_CODE_AGENT_HOOK_TOKEN=

# ─── PubMed MCP server (see docs/pubmed-mcp.md) ─────────────────────────────
# Shared secret MCP clients send as `Authorization: Bearer <token>` to
# /api/mcp. Generate with: openssl rand -base64 32
# The endpoint fails closed: with this unset it answers 503 and exposes
# nothing, so an unconfigured deployment is never an open relay to NCBI.
MCP_BEARER_TOKEN=

# NCBI E-utilities courtesy settings. Both are optional but recommended: the
# API key raises the rate ceiling from 3 to 10 requests/second, and the email
# is how NCBI contacts you before blocking a misbehaving client.
# Key from https://account.ncbi.nlm.nih.gov/settings/ → API Key Management.
NCBI_API_KEY=
NCBI_TOOL_EMAIL=

# ─── KineLab integration (see docs/kinelab-integration.md) ──────────────────
# Public (browser) — selects the active compute engine.
# Allowed: "lite" (default) | "full". Lite runs analytic PK + Monte Carlo in
# the browser; full proxies jobs to the external Python KineLab backend.
VITE_KINELAB_COMPUTE_MODE=lite

# Public (browser) — address the landing page offers for account requests.
# Unset: the page asks readers to contact the site administrator instead.
# VITE_CONTACT_EMAIL=

# Private (server) — contact address sent to Crossref/DataCite in the
# User-Agent (their "polite pool"). Unset: the header carries no mailto.
# METADATA_API_MAILTO=

# Private (server) — guards api/jobs/*. Must be exactly the string "true" for
# full-mode requests to be forwarded.
KINELAB_FULL_COMPUTE_ENABLED=false

# Private (server) — base URL of the external Python KineLab backend.
# Required when KINELAB_FULL_COMPUTE_ENABLED=true. Empty in lite-only
# deployments.
KINELAB_FULL_COMPUTE_API_URL=

# Email (Resend) — sign-in codes and opt-in notification emails. See api/_lib/email.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Secret the Vercel cron sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/notification-emails (opt-in notification email + overdue-dispute
# escalation, #1233). Set it in Vercel project env (generate with:
# openssl rand -base64 32). While it is unset the endpoint refuses every call,
# so no notification email is sent and nothing is escalated.
CRON_SECRET=
